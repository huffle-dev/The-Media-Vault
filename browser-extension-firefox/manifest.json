{
  "manifest_version": 3,
  "name": "The Media Vault — Quick Search",
  "version": "1.1.0",
  "description": "Send a media search from your browser into The Media Vault desktop app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-search@the-vault-media-centre",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "action": { "default_popup": "popup.html" },
  "permissions": ["tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
