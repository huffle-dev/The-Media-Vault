{
  "expo": {
    "name": "The Media Vault",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.mediavault.mobile",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#09090e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is only used to read the barcode of a book or CD when you scan one."
        }
      ],
      ["expo-share-intent", { "disableIOS": true, "androidIntentFilters": ["text/*"] }]
    ],
    "scheme": "mediavault",
    "extra": {
      "router": {}
    }
  }
}
