{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "skipLibCheck": true,
    "jsx": "react-jsx", "module": "esnext", "moduleResolution": "bundler", "target": "es2022",
    "strict": false, "noImplicitAny": false, "resolveJsonModule": true, "esModuleInterop": true,
    "types": []
  },
  "include": ["*.js", "src/**/*.js"],
  "exclude": ["node_modules", "dist", "metro.config.js"]
}
